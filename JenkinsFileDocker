pipeline
{
    agent any

    tools
    {
        maven 'Maven_3.9.14'
    }

    environment
    {
        buildNumber = "${BUILD_NUMBER}"
    }

    stages
    {
        stage('Checkout code to Jenkins from GitHub')
        {
            steps()
            {
                git branch: 'feature', url: 'https://github.com/apno1aj/Maven-Web-Application.git'
            }
        }

        stage('Build Artifact using Maven')
        {
            steps()
            {
                sh 'mvn clean package'
            }
        }

stage('SonarQube Analysis') {
    steps {
        withSonarQubeEnv('SonarQubeServer') {
            sh "mvn clean compile sonar:sonar -Dsonar.token=${SONAR_AUTH_TOKEN} -Dsonar.host.url=${SONAR_HOST_URL}"
        }
    }
}

        stage('Build Docker Image')
        {
            steps()
            {
                sh 'docker build -t apno1aj/maven-web-application:${buildNumber} .'
            }
        }

        stage("Authenticate and Push Docker Image to DockerHub")
        {
            steps()
            {
                withCredentials([string(credentialsId: 'Docker_PAT', variable: 'DOCKERHUB_PASSWORD')])
                {
                    sh 'echo $DOCKERHUB_PASSWORD | docker login -u apno1aj --password-stdin'
                    sh 'docker push apno1aj/maven-web-application:${buildNumber}'
                }
            }
        }

        stage('Remove Docker Image from Jenkins Locally')
        {
            steps()
            {
                sh 'docker rmi -f apno1aj/maven-web-application:${buildNumber}'
            }
        }

        stage('Deploy Application to Deployment Server')
        {
            steps()
            {
                sshagent([Deploymentserver_SSH])
                {
                    sh 'ssh -o StrictHostKeyChecking=no ubuntu@172.31.38.68 docker rm -f maven-web-application || true'
                    sh 'ssh -o StrictHostKeyChecking=no ubuntu@172.31.38.68 docker run -d --name maven-web-application -p 8080:8080 apno1aj/maven-web-application:${buildNumber}'
                }
            }
        }
    }
}
