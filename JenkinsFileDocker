pipeline
{
    agent any

    tools
    {
        maven 'Maven_3.9.14'
    }

    environment
    {
        buildNumber = "${BUILD_NUMBER}"
    }

    stages
    {
        stage('Checkout Code to Jenkins from GitHub')
        {
            steps()
            {
                git branch: 'feature', url: 'https://github.com/apno1aj/Maven-Web-Application.git'
            }
        }

        stage('Build Artifact using Maven')
        {
            steps()
            {
                sh 'mvn clean package'
            }
        }

	stage('SonarQube Analysis') {
    	    steps {
              withSonarQubeEnv('SonarQubeServer') {
				withCredentials([string(credentialsId: 'jenkins_ci_token', variable: 'jenkins_ci_token')]) {
            	sh 'mvn sonar:sonar -Dsonar.token=$jenkins_ci_token''
        					  }
    		  }
				    }

        stage("Build Docker Image")
        {
            steps()
            {
                sh 'docker build -t apno1aj/maven-web-application:${buildNumber} .'
            }
        }

        stage("Authenticate and Push Docker Image to Docker Hub")
        {
            steps()
            {
                withCredentials([string(credentialsId: 'Docker_Hub_Password', variable: 'Docker_Hub_Password')])
                {
                    sh 'docker login -u apno1aj -p ${Docker_Hub_Password}'
                }
                sh 'docker push apno1aj/maven-web-application:${buildNumber}'
            }
        }

        stage('Remove Docker Image from Jenkins Locally')
        {
            steps()
            {
                sh 'docker rmi -f apno1aj/maven-web-application:${buildNumber}'
            }
        }

        stage('Deploy Application to Deployment Server')
        {
            steps()
            {
                sshagent(['Deploymentserver_SSH'])
                {
                    sh "ssh -o StrictHostKeyChecking=no ubuntu@100.52.207.113 docker rm -f mavenwebapplication || true"
                    sh "ssh -o StrictHostKeyChecking=no ubuntu@100.52.207.113 docker run -d --name mavenwebapplication -p 8080:8080 apno1aj/maven-web-application:$Build_Number"
                }
            }
        }
    }
}
